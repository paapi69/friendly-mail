{
  "name": "friendly-mail",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @friendly-mail/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @friendly-mail/database",
    "db:migrate:status": "npm run db:migrate:status --workspace @friendly-mail/database",
    "db:validate": "npm run db:validate --workspace @friendly-mail/database",
    "dev:api": "npm run dev --workspace @friendly-mail/api",
    "dev:dashboard": "npm run dev --workspace @friendly-mail/dashboard",
    "dev:addin": "npm run dev --workspace @friendly-mail/outlook-addin",
    "dev:worker": "npm run dev --workspace @friendly-mail/queue",
    "lint": "eslint .",
    "postinstall": "npm run db:generate",
    "queue:health": "npm run queue:health --workspace @friendly-mail/queue",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run db:generate && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}

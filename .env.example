NODE_ENV=development
API_PORT=4000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
SESSION_SECRET=replace-me
SESSION_COOKIE_NAME=friendly_mail_session
SESSION_MAX_AGE_HOURS=12
